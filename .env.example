# Neon Postgres connection string used by src/db/client.ts
DATABASE_URL=

# Better Auth session/cookie signing secret — generate with `openssl rand -hex 32`
BETTER_AUTH_SECRET=
# Deployed origin, e.g. https://papeterie.example — leave empty in dev
BETTER_AUTH_URL=

# Cloudinary — required. Cloud name is public (client-safe); API key/secret sign
# uploads and deletes server-side and must stay secret.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Storefront origin for canonical URLs / OpenGraph / sitemap.xml — leave empty
# in dev (defaults to http://localhost:3000). No real domain decided yet.
NEXT_PUBLIC_SITE_URL=

# WhatsApp Business number for order handoff, 222XXXXXXXX (no "+"). Leave
# Full international form, digits only, no "+" and no spaces — this is
# concatenated straight into a `wa.me/<number>` URL. Mauritania is 222, so an
# 8-digit local number becomes 222XXXXXXXX (e.g. 27139094 -> 22227139094).
# Leave empty and the footer, the product "ask" link and the checkout
# confirmation all degrade gracefully rather than showing a broken link.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Sentry + PostHog — leave empty in dev to disable both.
# Both are additionally gated on VERCEL_ENV=production, so preview deploys stay
# inert even with these set: the Vitest suite runs against a real database, and
# preview traffic would spend the same 5k-errors/month free tier as production.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""            # Vercel build source-map upload, prod only
SENTRY_ORG=""                   # Required for upload — it fails silently without org/project
SENTRY_PROJECT=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"

# Admin account created by `npm run db:seed` — dev/staging only
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
